# /etc/guojing/production.env, root:guojing 0640. No shell expansion.
GUOJING_ENVIRONMENT=production
GUOJING_DEBUG=false
GUOJING_DATABASE_URL=sqlite:////var/lib/guojing/data/guojing.db
GUOJING_DEPLOYMENT_ID=hangzhou-pilot
GUOJING_DEEPSEEK_API_KEY=REPLACE_WITH_SECRET
GUOJING_DEEPSEEK_BASE_URL=https://api.deepseek.com
GUOJING_DEEPSEEK_VISION_MODEL=deepseek-flash
GUOJING_DEEPSEEK_MODEL_TIMEOUT_SECONDS=30
GUOJING_AGENT_MAX_CONCURRENCY=2
GUOJING_AGENT_QUEUE_CAPACITY=8
GUOJING_AGENT_QUEUE_TIMEOUT_SECONDS=30
GUOJING_AGENT_RUN_TIMEOUT_SECONDS=90
GUOJING_SANDBOX_CLEANUP_TIMEOUT_SECONDS=5
GUOJING_AGENT_SESSION_TTL_HOURS=24
GUOJING_DEVICE_MAXIMUM=10
GUOJING_DEVICE_DAILY_LIMIT=50
GUOJING_GLOBAL_DAILY_LIMIT=300
GUOJING_MINIMUM_FREE_DISK_BYTES=1073741824
# Replace UID after bootstrap; use the digest printed by docker image inspect.
GUOJING_SANDBOX_DOCKER_HOST=unix:///run/user/REPLACE_UID/docker.sock
GUOJING_SANDBOX_IMAGE=REPLACE_REGISTRY/python@sha256:REPLACE_DIGEST
GUOJING_OSS_BUCKET=REPLACE_PRIVATE_HANGZHOU_BUCKET
GUOJING_OSS_ROLE_NAME=REPLACE_ECS_RAM_ROLE
# Receiver must accept {service: "guojing", issues: [codes...]}; keep URL secret.
GUOJING_ALERT_WEBHOOK=https://REPLACE_ALERT_RECEIVER
