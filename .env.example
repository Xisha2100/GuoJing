# Copy this file to .env.local for local development. .env.local is loaded
# automatically and ignored by Git; process environment variables take precedence.
GUOJING_ENVIRONMENT=local
GUOJING_DATABASE_URL=sqlite:///./data/guojing.db

# Required in staging and production. Never commit a real key.
GUOJING_DEEPSEEK_API_KEY=replace-me
GUOJING_DEEPSEEK_BASE_URL=https://api.deepseek.com
GUOJING_DEEPSEEK_VISION_MODEL=deepseek-flash
GUOJING_DEEPSEEK_MODEL_TIMEOUT_SECONDS=30

GUOJING_AGENT_RUN_TIMEOUT_SECONDS=90
GUOJING_AGENT_MAX_CONCURRENCY=2
GUOJING_AGENT_QUEUE_CAPACITY=8
GUOJING_AGENT_CONFIDENCE_THRESHOLD=0.70
GUOJING_AGENT_SESSION_TTL_HOURS=24

# Empty uses DOCKER_HOST or the local Docker default. Production requires a
# rootless local Unix socket and a pre-pulled image pinned by sha256 digest.
GUOJING_SANDBOX_DOCKER_HOST=
GUOJING_SANDBOX_IMAGE=python:3.12-slim
GUOJING_SANDBOX_IDLE_TTL_SECONDS=600

GUOJING_AGENT_QUEUE_TIMEOUT_SECONDS=30
GUOJING_SANDBOX_CLEANUP_TIMEOUT_SECONDS=5
GUOJING_DEVICE_MAXIMUM=10
GUOJING_DEVICE_DAILY_LIMIT=50
GUOJING_GLOBAL_DAILY_LIMIT=300
GUOJING_DEPLOYMENT_ID=local
GUOJING_MINIMUM_FREE_DISK_BYTES=1073741824
