# Copy values into process environment variables; the API does not auto-load .env.
GUOJING_DATABASE_URL=sqlite:///./data/guojing.db

# Keep false only for local HTTP development. Staging and production require true and HTTPS.
GUOJING_ADMIN_COOKIE_SECURE=false
GUOJING_ADMIN_SESSION_TTL_MINUTES=480
GUOJING_ADMIN_LOGIN_WINDOW_MINUTES=15
GUOJING_ADMIN_MAXIMUM_LOGIN_FAILURES=5
